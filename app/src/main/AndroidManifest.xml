<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-feature android:name="android.software.leanback" android:required="false"/>
 <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
 <application android:theme="@style/Theme.USportz" android:label="USportz" android:usesCleartextTraffic="true" android:supportsRtl="true">
  <activity android:name=".RichSportsActivity" android:screenOrientation="unspecified" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <activity android:name=".MainActivity" android:screenOrientation="unspecified" android:exported="true"/>
  <activity android:name=".TvMainActivity" android:screenOrientation="landscape" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
  </activity>
 </application>
</manifest>
